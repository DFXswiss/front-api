{
  "title": "Offered routes: usage and frontend E2E",
  "rules": "Every path this process answers itself has a row. usedIn names a public consumer repo and file. e2e names a frontend-inclusive E2E in a public repo (any branch; this repo's CI does not run it). Private repositories are not named. Proxied backend routes are not listed.",
  "routes": [
    {
      "method": "GET",
      "path": "/",
      "match": "exact",
      "usedIn": [
        {
          "repo": "DFXswiss/front-api",
          "path": "server.js",
          "note": "Local JSON/HTML landing when Accept prefers HTML; served from this process."
        }
      ],
      "e2e": [
        {
          "repo": "DFXswiss/services",
          "path": "e2e-stack/specs/smoke.spec.ts",
          "note": "Full-stack widget harness reaches this HTTP layer. Browser GET / is also the swagger landing when used as the API origin."
        }
      ]
    },
